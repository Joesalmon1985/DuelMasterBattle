; Engine configuration file.
config_version=5

[application]
config/name="DuelMasterBattle"
config/description="Duelling Mastermind — authoritative sim + client"
run/main_scene="res://client/scenes/main_menu.tscn"
config/features=PackedStringArray("4.4")

[autoload]
EncounterSession="*res://client/scripts/encounter_session.gd"
Sfx="*res://client/scripts/sfx.gd"
Adventure="*res://client/scripts/adventure.gd"
PuzzleTestRunner="*res://client/scripts/puzzle_test_runner.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/window_width_override=450
window/size/window_height_override=800

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
